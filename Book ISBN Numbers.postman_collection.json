{
  "info": {
    "_postman_id": "7d7539a0-ebd4-4278-8c9f-3528cbeba7e8",
    "name": "Book ISBN Numbers",
    "description": "SOAP API для валідації ISBN номерів книг. Колекція містить два запити: IsValidISBN10 та IsValidISBN13.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "53739621"
  },
  "item": [
    {
      "name": "IsValidISBN10",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// ===== RESPONSE BODY TESTS (7) =====",
              "",
              "// Тест 1: Перевірка статус-коду 200",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Тест 2: Тіло відповіді містить IsValidISBN10Result",
              "pm.test(\"Body contains IsValidISBN10Result\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"IsValidISBN10Result\");",
              "});",
              "",
              "// Тест 3: Результат валідації = true",
              "pm.test(\"ISBN10 result is true\", function () {",
              "    var xml = pm.response.text();",
              "    pm.expect(xml).to.include(\"<m:IsValidISBN10Result>true</m:IsValidISBN10Result>\");",
              "});",
              "",
              "// Тест 4: Відповідь містить SOAP Envelope",
              "pm.test(\"Response has SOAP Envelope\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"soap:Envelope\");",
              "});",
              "",
              "// Тест 5: Відповідь містить SOAP Body",
              "pm.test(\"Response has SOAP Body\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"soap:Body\");",
              "});",
              "",
              "// Тест 6: Відповідь є валідним XML (починається з <?xml)",
              "pm.test(\"Response is valid XML\", function () {",
              "    var xml = pm.response.text();",
              "    pm.expect(xml).to.match(/^<\\?xml/);",
              "});",
              "",
              "// Тест 7: Namespace ISBN присутній у відповіді",
              "pm.test(\"ISBN namespace present\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"webservices.daehosting.com/ISBN\");",
              "});",
              "",
              "// ===== HEADERS TESTS (3) =====",
              "",
              "// Тест 8: Content-Type містить text/xml",
              "pm.test(\"Content-Type is text/xml\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/xml\");",
              "});",
              "",
              "// Тест 9: Час відповіді менше 5000 мс",
              "pm.test(\"Response time is less than 5000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(5000);",
              "});",
              "",
              "// Тест 10: Заголовок Server присутній",
              "pm.test(\"Server header is present\", function () {",
              "    pm.expect(pm.response.headers.get(\"Server\")).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/xml; charset=utf-8"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN10 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>0-19-852663-6</sISBN>\n    </IsValidISBN10>\n  </soap:Body>\n</soap:Envelope>",
          "options": {
            "raw": {
              "language": "xml"
            }
          }
        },
        "url": {
          "raw": "http://webservices.daehosting.com/services/isbnservice.wso",
          "protocol": "http",
          "host": [
            "webservices",
            "daehosting",
            "com"
          ],
          "path": [
            "services",
            "isbnservice.wso"
          ]
        }
      },
      "response": []
    },
